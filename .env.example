# ---------------------------------------------------------------
# HireIQ environment template.
#   1) Copy this file:   cp .env.example .env
#   2) Edit .env and replace every "change-me" value.
#   3) NEVER commit .env to GitHub (it is in .gitignore).
# ---------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by the postgres container AND by the app) ---
POSTGRES_USER=hireiq
POSTGRES_PASSWORD=change-me-use-a-strong-database-password
POSTGRES_DB=hireiq

# DATABASE_URL is used when you run the backend directly on your machine
# (NOT in Docker). Docker Compose builds its own URL using the service name "postgres".
DATABASE_URL=postgresql+psycopg://hireiq:change-me-use-a-strong-database-password@localhost:5432/hireiq

# --- Redis (Celery broker + result backend) ---
# Docker Compose overrides this with redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string

# --- LLM API keys. Keep EMPTY here; put real keys only in your private .env (server-side only) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- CORS: comma-separated list of allowed frontend origins (exact origins; never "*" in production) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend container (Docker Compose only) ---
# Address the BROWSER uses to reach the API. Baked into the frontend at build time (rebuild after changing it).
# Public value only: never put keys or tokens here.
VITE_API_BASE_URL=http://localhost:8000
# Host port for the frontend container (http://localhost:3000 by default; must match an origin in CORS_ORIGINS).
FRONTEND_PORT=3000

# --- Audio upload (Day 2) ---
# Maximum size of one recorded answer, in megabytes.
AUDIO_MAX_UPLOAD_MB=25
# (Docker Compose stores temporary audio in a private volume; outside Docker the default is /tmp/hireiq-audio.)

# --- Transcription (Day 3) ---
# mock   = fake placeholder text, NO speech recognition (default; refused when ENVIRONMENT=production)
# openai = official OpenAI Whisper API (needs OPENAI_API_KEY above, kept on the server only)
# local  = open-source Whisper on this machine (pip install -r backend/requirements-whisper-local.txt)
TRANSCRIPTION_PROVIDER=mock
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LOCAL_WHISPER_MODEL=base
# Optional language hint for Whisper (e.g. en, hi). Leave blank for automatic detection (recommended for mixed-language candidates).
# TRANSCRIPTION_LANGUAGE=
# Longest accepted answer, in seconds.
AUDIO_MAX_DURATION_SECONDS=600

# --- LLM evaluation (Day 4) ---
# mock   = fake placeholder scores, NO language model (default; refused when ENVIRONMENT=production)
# openai = OpenAI chat model (needs OPENAI_API_KEY above, kept on the server only)
EVALUATION_PROVIDER=mock
EVALUATION_MODEL=gpt-4o
EVALUATION_TIMEOUT_SECONDS=60
EVALUATION_MAX_RETRIES=3
EVALUATION_RETRY_BACKOFF_SECONDS=5
# Optional: folder with YAML rubric files. Leave unset to use backend/config/rubrics.
# RUBRICS_DIR=

# --- Day 5: NLP enrichment (spaCy + VADER; no external API) ---
# NLP_ENABLED=true
# NLP_SPACY_MODEL=en_core_web_sm

# --- Day 6: PDF report download ---
# Shared secret for GET /api/reports/{session_id}/pdf (header "Authorization: Bearer <token>"). At least 16 characters.
# Leave EMPTY to disable report downloads (the endpoint then answers 503). Never commit a real value.
REPORT_ACCESS_TOKEN=
