# ---------------------------------------------------------------
# HireIQ environment template.
#   1) Copy this file:   cp .env.example .env
#   2) Edit .env and replace every "change-me" value.
#   3) NEVER commit .env to GitHub (it is in .gitignore).
# ---------------------------------------------------------------

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL (used by the postgres container AND by the app) ---
POSTGRES_USER=hireiq
POSTGRES_PASSWORD=change-me-use-a-strong-database-password
POSTGRES_DB=hireiq

# DATABASE_URL is used when you run the backend directly on your machine
# (NOT in Docker). Docker Compose builds its own URL using the service name "postgres".
DATABASE_URL=postgresql+psycopg://hireiq:change-me-use-a-strong-database-password@localhost:5432/hireiq

# --- Redis (Celery broker + result backend) ---
# Docker Compose overrides this with redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-string

# --- LLM providers (Day 4). Keep EMPTY here; put real keys only in your private .env ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Audio upload (Day 2) ---
# Maximum size of one recorded answer, in megabytes.
AUDIO_MAX_UPLOAD_MB=25
# (Docker Compose stores temporary audio in a private volume; outside Docker the default is /tmp/hireiq-audio.)

# --- Transcription (Day 3) ---
# mock   = fake placeholder text, NO speech recognition (default; refused when ENVIRONMENT=production)
# openai = official OpenAI Whisper API (needs OPENAI_API_KEY above, kept on the server only)
# local  = open-source Whisper on this machine (pip install -r backend/requirements-whisper-local.txt)
TRANSCRIPTION_PROVIDER=mock
OPENAI_TRANSCRIPTION_MODEL=whisper-1
LOCAL_WHISPER_MODEL=base
# Longest accepted answer, in seconds.
AUDIO_MAX_DURATION_SECONDS=600

