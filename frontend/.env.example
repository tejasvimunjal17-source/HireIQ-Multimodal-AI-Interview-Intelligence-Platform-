# Frontend environment (Vite). Copy to .env.local for your own values.
# Only VITE_* variables are visible to the browser: NEVER put API keys here.

# Where the FastAPI backend lives.
VITE_API_BASE_URL=http://localhost:8000

# true = use built-in SAMPLE data and send nothing to a server (UI preview only).
VITE_DEMO_MODE=false

# Upload timeout in milliseconds.
VITE_UPLOAD_TIMEOUT_MS=60000
